# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://ebms_user:changeme@localhost:5432/ebms_db?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-value-before-deployment"
JWT_EXPIRES_IN="8h"

# Encryption (32-byte key, hex-encoded, for AES-256-GCM submission encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Opening quorum: number of distinct opening-panel confirmations required
# before a sealed envelope may be decrypted (SOAR FR-OPEN-003/004)
OPENING_QUORUM=2

# Cooling-off period, in days (PPA cooling-off requirement, SOAR 3.2 / FR-AWD-005)
COOLING_OFF_DAYS=10
